---


 const BRANDS = {
  "Pickleball/Padel": [
    { name: "Paddletek", badge: "Performance Paddles", imgAlt: "Paddletek brand image" },
    { name: "Padeltek", badge: "Performance Rackets", imgAlt: "Padeltek brand image" },
    { name: "ProXR Pickleball", badge: "Innovative Paddles", imgAlt: "ProXR Pickleball brand image" },
    { name: "Example Brand 4", badge: "Accessories", imgAlt: "Example brand 4 image" },
    { name: "Example Brand 5", badge: "Apparel", imgAlt: "Example brand 5 image" },
    { name: "Example Brand 6", badge: "Bags", imgAlt: "Example brand 6 image" },
    { name: "Example Brand 7", badge: "Balls", imgAlt: "Example brand 7 image" },
  ],
  Baseball: [
    { name: "Example Baseball 1", badge: "Gloves", imgAlt: "Example baseball 1 image" },
    { name: "Example Baseball 2", badge: "Bats", imgAlt: "Example baseball 2 image" },
    { name: "Example Baseball 3", badge: "Training", imgAlt: "Example baseball 3 image" },
  ],
  "Sport Style": [
    { name: "Example Style 1", badge: "Footwear", imgAlt: "Example style 1 image" },
    { name: "Example Style 2", badge: "Athleisure", imgAlt: "Example style 2 image" },
    { name: "Example Style 3", badge: "Outerwear", imgAlt: "Example style 3 image" },
  ],
  Training: [
    { name: "Example Training 1", badge: "Agility", imgAlt: "Example training 1 image" },
    { name: "Example Training 2", badge: "Recovery", imgAlt: "Example training 2 image" },
    { name: "Example Training 3", badge: "Strength", imgAlt: "Example training 3 image" },
  ],
};

const HOURS = [
  ["Monday", "10 am–5 pm"],
  ["Tuesday", "10 am–5 pm"],
  ["Wednesday", "10 am–5 pm"],
  ["Thursday", "10 am–5 pm"],
  ["Friday", "10 am–5 pm"],
  ["Saturday", "Closed"],
  ["Sunday", "Closed"],
];

const ADDRESS_LINE = "220 Messner Dr, Wheeling, IL 60090";
const PHONE = "(847)780-4094";
const EMAIL = "windycitysports@35services.com";
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="https://use.typekit.net/vra0lhe.css">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Windy City Sports Outlet</title>

    <style>
      :root{
        --navy: #1F4968;
        --red: #EA1313;
        --light-blue: #B5E3F3;
        --bg: #ffffff;
        --max: 1120px;

        --marquee-duration: 30s;
      }

      *{ box-sizing: border-box; }
      html{ scroll-behavior: smooth; }
      body{
        margin: 0;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
        color: #000;
        background: var(--bg);
      }
      a{ color: inherit; text-decoration: none; }

      /* Top slim navy bar */
      .topbar{
        background: var(--navy);
        color: var(--light-blue);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-size: 12px;
        line-height: 1;
        padding: 10px 12px;
        text-align: center;
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
        font-style: normal;
      }

      /* Red marquee banner (seamless loop) */
      .marquee{
        background: var(--red);
        color: #fff;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        overflow: hidden;
        white-space: nowrap;
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
        font-style: normal;
        font-size: 12px;
      }
      .marquee__viewport{
        position: relative;
      }
      .marquee__viewport::before,
      .marquee__viewport::after{
        content:"";
        position:absolute;
        top:0; bottom:0;
        width: 36px;
        pointer-events:none;
        z-index: 2;
      }
      .marquee__viewport::before{
        left:0;
        background: linear-gradient(90deg, rgba(234,19,19,1) 0%, rgba(215,43,43,0) 100%);
      }
      .marquee__viewport::after{
        right:0;
        background: linear-gradient(270deg, rgba(234,19,43,1) 0%, rgba(215,43,43,0) 100%);
      }

      .marquee__track{
        display: inline-flex;
        align-items: center;
        /* IMPORTANT: no gap here—use padding within items so the duplicated track aligns perfectly */
        will-change: transform;
        animation: marquee var(--marquee-duration) linear infinite;
      }

      /* Two identical groups inside track; animation moves exactly one group width (-50%) */
      .marquee__group{
        display: inline-flex;
        align-items: center;
      }

      .marquee__item{
        display: inline-flex;
        align-items: center;
        padding: 10px 12px;
      }

      .marquee__starImg{
        width: 14px;
        height: 14px;
        object-fit: contain;
        display: inline-block;
      }

      @keyframes marquee{
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
      }

      /* Header */
      header{
        background: #fff;
      }
      .header__inner{
        max-width: var(--max);
        margin: 0 auto;
        padding: 18px 18px 12px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
      }

      .logoLink{
        display: inline-flex;
        align-items: center;
      }
      .logoImg{
        width: 160px;
        height: auto;
        display: block;
      }

      nav{
        display: flex;
        align-items: center;
        gap: 26px;
        padding-top: 10px;
        color: #000;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
        font-style: normal;
      }
      nav a{ font-size: 18px; }
      nav a:hover{
        text-decoration: underline;
        text-underline-offset: 6px;
      }

      .heroFullBleed{
        width: 100%;
      }
      .heroImg{
        width: 100%;
        height: 600px;
        display: block;
        object-fit: cover;
      }

      /* One-stop shop section */
      .oneStop{
        padding: 80px 18px 22px;
        text-align: center;
      }
      .starsWrap{
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
      }
      .starsImg{
        width: 96px;
        height: auto;
        display: block;
      }

      .h1{
        margin: 0;
        font-size: 44px;
        line-height: 1.02;
        letter-spacing: 0.02em;
        color: var(--navy);
        text-transform: uppercase;
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
        font-style: normal;
      }
      .subhead{
        margin: 10px auto 18px;
        font-size: 28px;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
        font-style: normal;
      }
      .body{
        max-width: 840px;
        margin: 0 auto;
        color: #000;
        font-size: 18px;
        line-height: 1.55;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
        font-style: normal;
        text-align: left;
        padding: 40px;
      }
      .body p{ margin: 0 0 14px; }

      .hoursBand{
        background: var(--navy);
        color: #fff;
        padding: 80px 18px;
      }
      .hoursBand__inner{
        max-width: var(--max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: center;
      }
      .hoursImg{
        width: 80%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        display: block;
        background: var(--navy);
      }
      .hoursTitle{
        margin: 0 0 16px;
        font-size: 28px;
        color: var(--light-blue);
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
        font-style: normal;
      }
      .hoursList{
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 10px;
        max-width: 360px;
      }
      .hoursRow{
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1px;
        font-size: 18px;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
        font-style: normal;
      }


      /* Brands section */
      .brands{ padding: 80px 18px 10px; }
      .brands__inner{ max-width: var(--max); margin: 0 auto; }
      .brandsTop{
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 18px;
      }
      .brandsTitle{
        margin: 0;
        color: var(--red);
        font-size: 28px;
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
        font-style: normal;
      }
      .tabs{
        display: flex;
        align-items: center;
        gap: 18px;
        font-size: 18px;
        color: #000;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
        font-style: normal;
      }
      .tab{
        padding: 6px 2px;
        border: 0;
        background: transparent;
        cursor: pointer;
        font: inherit;
        color: inherit;
        border-bottom: 2px solid transparent;
      }
      .tab[aria-selected="true"]{ border-bottom-color: #000; }

      .cardsShell{
        position: relative;
        padding-right: 0px;
        max-width: var(--max);
        margin: 0 auto;
        overflow: hidden;
      }
      .cardsGrid{
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: calc((100% - 36px) / 3);
        gap: 18px;
        width: 100%;
      }
      .card{
        width: 100%;
        aspect-ratio: 4/5;
        position: relative;
        overflow: hidden;
        flex-direction: column;
      }
      .card__img{
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .card__overlay{
        position: absolute;
        left: 0; right: 0; bottom: 0;
        padding: 16px 14px 14px;
        background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,.56) 55%, rgba(0,0,0,.72) 100%);
        color: #fff;
      }
      .card__name{
        font-size: 14px;
        margin: 0 0 8px;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
        font-style: normal;
      }
      .card__badge{
        display: inline-block;
        background: var(--red);
        color: #fff;
        font-size: 10px;
        letter-spacing: .06em;
        text-transform: uppercase;
        padding: 4px 8px;
        border-radius: 3px;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
        font-style: normal;
      }

      .pager{
        position: absolute;
        top: 50%;
        right: 0;
        transform: translateY(-50%);
        display: grid;
        gap: 10px;
      }
      .pager button{
        width: 28px;
        height: 28px;
        background: #fff;
        cursor: pointer;
        display: grid;
        place-items: center;
        line-height: 1;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
        font-style: normal;
      }
      .pager button:disabled{ opacity: .35; cursor: not-allowed; }

      /* Visit section */
      .visit{ padding: 80px 18px 0; }
      .visit__inner{ max-width: var(--max); margin: 0 auto; }
      .visitTitle{
        margin: 0 0 8px;
        color: var(--red);
        font-size: 28px;
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
        font-style: normal;
      }
      .visitAddr{
        margin: 0 0 14px;
        font-size: 18px;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
        font-style: normal;
      }
      .map{
        width: 100%;
        height: 500px;
        overflow: hidden;
        background: #fff;
      }
      .map iframe{ width: 100%; height: 100%; border: 0; }

      /* Contact section */
      .contact{
        padding: 80px 18px;
        text-align: center;
      }
      .contactTitle{
        margin: 0 0 8px;
        color: var(--red);
        font-size: 28px;
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
        font-style: normal;
      }
      .contact p{
        margin: 6px 0;
        font-size: 18px;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
        font-style: normal;
      }

      .fbIcon{
        width: 26px;
        height: 26px;
        display: inline-block;
        margin-top: 6px;
        object-fit: contain;
      }

      /* Footer */
      footer{
        background: var(--navy);
        color: #fff;
        padding: 44px 18px 28px;
        text-align: center;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
        font-style: normal;
      }
      .footerLogoImg{
        width: 170px;
        height: auto;
        display: block;
        margin: 0 auto 12px;
      }
      .fine{
        font-size: 11px;
        opacity: .9;
        line-height: 1.6;
      }

      .marquee__item,
      .marquee__starImg {
        display: inline-block;
        margin-right: 40px;
        vertical-align: middle;
      }


      /* Responsive */
      @media (max-width: 920px){
        .heroImg{ height: 300px; }
        .hoursBand__inner{ grid-template-columns: 1fr; }
        .cardsGrid{ grid-template-columns: 1fr; }
        .cardsShell{ padding-right: 0px; }
        .pager{
          position: static;
          transform: none;
          display: flex;
          justify-content: flex-end;
          margin-top: 12px;
        }
      }

      @media (prefers-reduced-motion: reduce){
        html{ scroll-behavior: auto; }
        .marquee__track{ animation: none; }
      }
    </style>
  </head>

  <body>
    <div class="topbar">
      OUR PROS ARE HERE TO HELP YOU FIND THE RIGHT PICKLEBALL, PADEL, AND BASEBALL EQUIPMENT
    </div>

    <!-- Marquee (two identical groups, animates -50% for seamless loop) -->
    <div class="marquee" aria-label="Grand opening banner">
  <div class="marquee__viewport">
    <div class="marquee__track" aria-hidden="true">
      <div class="marquee__group">
        {Array.from({ length: 10 }).map(() => (
          <>
            <span class="marquee__item">Grand Opening 2/16</span>
            <img class="marquee__starImg" src="/white-star.svg" alt="white six-point star" />
          </>
        ))}
      </div>

      <div class="marquee__group" aria-hidden="true">
        {Array.from({ length: 10 }).map(() => (
          <>
            <span class="marquee__item">Grand Opening 2/16</span>
            <img class="marquee__starImg" src="/white-star.svg" alt="white six-point star" />
          </>
        ))}
      </div>
    </div>
  </div>
</div>


    <header>
      <div class="header__inner">
        <a class="logoLink" href="#top" aria-label="Windy City Sports Outlet home">
          <img class="logoImg" src="/wcso_primary-logo_color-black.png" alt="Windy City Sports Outlet logo" />
        </a>

        <nav aria-label="Primary navigation">
          <a href="#hours">Hours</a>
          <a href="#brands">Brands</a>
          <a href="#visit">Visit</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>

      <div class="heroFullBleed" id="top">
        <img class="heroImg" src="/wcso_hero-banner.jpg" alt="interior of Windy City Sports Outlet store" />
      </div>
    </header>

    <main>
      <section class="oneStop" aria-label="Intro">
        <div class="starsWrap">
          <img class="starsImg" src="/red-star_cluster.svg" alt="three red six-point stars" />
        </div>

        <h1 class="h1">YOUR ONE-STOP SHOP</h1>
        <div class="subhead">Find the High-Quality Equipment That Is Right for You</div>

        <div class="body">
          <p>
            We specialize in pickleball, padel, and baseball gear, along with a wide selection of equipment and apparel
            for athletes of all ages. Whether you’re a beginner or a seasoned player, our friendly team will help you find
            the right gear to elevate your game.
          </p>
          <p>
            Our sporting goods showroom features paddles, rackets, gloves, bats, footwear, bags, and accessories. We
            also offer an indoor test court and a custom shop where you can build personalized or branded pickle ball
            equipment for charity or corporate functions.
          </p>
          <p>
            We’ve got everything you need under one roof. Stop by today and gear up with the best at Windy City
            Sports Outlet!
          </p>
        </div>
      </section>

      <section id="hours" class="hoursBand" aria-label="Our Hours">
        <div class="hoursBand__inner">
          <img class="hoursImg" src="/wcso_cropped-image.jpg" alt="Chicago Slice merchandise in Windy City Sports Outlet store" />

          <div>
            <h2 class="hoursTitle">Our Hours</h2>
            <ul class="hoursList">
              {HOURS.map(([day, hours]) => (
                <li class="hoursRow">
                  <span>{day}</span>
                  <span>{hours}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="brands" class="brands" aria-label="Brands We Carry">
        <div class="brands__inner">
          <div class="brandsTop">
            <h2 class="brandsTitle">Brands We Carry</h2>

            <div class="tabs" role="tablist" aria-label="Brand categories">
              {Object.keys(BRANDS).map((key, idx) => (
                <button
                  class="tab"
                  type="button"
                  role="tab"
                  aria-selected={idx === 0 ? "true" : "false"}
                  data-tab={key}
                >
                  {key}
                </button>
              ))}
            </div>
          </div>

          <div class="cardsShell">
            <div class="cardsGrid" id="brand-grid" aria-live="polite"></div>

            <div class="pager" aria-label="Brand paging controls">
              <button id="brands-prev" type="button" aria-label="Previous page">‹</button>
              <button id="brands-next" type="button" aria-label="Next page">›</button>
            </div>
          </div>
        </div>
      </section>

      <section id="visit" class="visit" aria-label="Visit">
        <div class="visit__inner">
          <h2 class="visitTitle">Visit</h2>
          <p class="visitAddr">{ADDRESS_LINE}</p>

          <div class="map" role="application" aria-label="Interactive map">
            <iframe
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              src={`https://www.google.com/maps?q=${encodeURIComponent(ADDRESS_LINE)}&output=embed`}
              title="Windy City Sports Outlet Map"
            ></iframe>
          </div>
        </div>
      </section>

      <section id="contact" class="contact" aria-label="Contact">
        <h2 class="contactTitle">Contact</h2>
        <p>{PHONE}</p>
        <p>{EMAIL}</p>
      
        <a href="#" aria-label="Facebook link">
          <img class="fbIcon" src="/facebook_primary-logo.svg" alt="Facebook primary logo" />
        </a>
      </section>
    </main>

    <footer>
      <img class="footerLogoImg" src="/wcso_secondary-logo_color-white.png" alt="Windy City Sports Outlet logo" />

      <div class="fine">
        © 2026 Windy City Sports Outlet<br/>
        {ADDRESS_LINE} &nbsp;|&nbsp; {PHONE} &nbsp;|&nbsp; {EMAIL}
      </div>
    </footer>

    <script>
      // --- Brands tabs + paging (3 columns + arrows when more) ---
      const brandData = {
        "Pickleball/Padel": [
          { name: "Paddletek", badge: "Performance Paddles", img: "/paddletek_card.jpg" },
          { name: "Padeltek", badge: "Performance Rackets", img: "/padeltek_card.jpg" },
          { name: "ProXR Pickleball", badge: "Innovative Paddles", img: "/proxr-pickleball_card.jpg" },
          { name: "Example Brand 4", badge: "Accessories", img: "" },
          { name: "Example Brand 5", badge: "Apparel", img: "" },
          { name: "Example Brand 6", badge: "Bags", img: "" },
          { name: "Example Brand 7", badge: "Balls", img: "" },
        ],
        Baseball: [
          { name: "Example Baseball 1", badge: "Gloves", img: "" },
          { name: "Example Baseball 2", badge: "Bats", img: "" },
          { name: "Example Baseball 3", badge: "Training", img: "" },
        ],
        "Sport Style": [
          { name: "Example Style 1", badge: "Footwear", img: "" },
          { name: "Example Style 2", badge: "Athleisure", img: "" },
          { name: "Example Style 3", badge: "Outerwear", img: "" },
        ],
        Training: [
          { name: "Example Training 1", badge: "Agility", img: "" },
          { name: "Example Training 2", badge: "Recovery", img: "" },
          { name: "Example Training 3", badge: "Strength", img: "" },
        ],
      };

      const PAGE_SIZE = 3;

      const grid = document.getElementById("brand-grid");
      const tabs = Array.from(document.querySelectorAll(".tab"));
      const prevBtn = document.getElementById("brands-prev");
      const nextBtn = document.getElementById("brands-next");

      let activeCategory = tabs[0]?.dataset.tab || "Pickleball/Padel";
      let page = 0;

      function setTabSelected(category){
        tabs.forEach(t => t.setAttribute("aria-selected", String(t.dataset.tab === category)));
      }

      function render(){
        const items = brandData[activeCategory] || [];
        const totalPages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
        page = Math.min(page, totalPages - 1);

        const start = page * PAGE_SIZE;
        const slice = items.slice(start, start + PAGE_SIZE);

        grid.innerHTML = "";

        slice.forEach(item => {
          const card = document.createElement("article");
          card.className = "card";

          // Real <img> tag; you can paste URLs into your data or keep them blank.
          const img = document.createElement("img");
          img.className = "card__img";
          img.alt = item.name + " brand image";
          img.src = item.img || ""; // leave blank until you set it

          const overlay = document.createElement("div");
          overlay.className = "card__overlay";

          const name = document.createElement("p");
          name.className = "card__name";
          name.textContent = item.name;

          const badge = document.createElement("span");
          badge.className = "card__badge";
          badge.textContent = item.badge;

          overlay.appendChild(name);
          overlay.appendChild(badge);
          card.appendChild(img);
          card.appendChild(overlay);
          grid.appendChild(card);
        });

        prevBtn.disabled = page <= 0;
        nextBtn.disabled = page >= totalPages - 1;
      }

      tabs.forEach(btn => {
        btn.addEventListener("click", () => {
          activeCategory = btn.dataset.tab;
          page = 0;
          setTabSelected(activeCategory);
          render();
        });
      });

      prevBtn.addEventListener("click", () => { page = Math.max(0, page - 1); render(); });
      nextBtn.addEventListener("click", () => { page = page + 1; render(); });

      setTabSelected(activeCategory);
      render();
    </script>
  </body>
</html>
