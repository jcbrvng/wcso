---
/* ==========================================
   Windy City Sports Outlet (WCSO) — Single Page
   Notes:
   - Self-contained (CSS + JS in this file).
   - Styles are global because brand cards are injected via JS.
   - Put images in /public and update the src paths below.
   ========================================== */

   const BRANDS = {
  "Pickleball/Padel": [
    { name: "Paddletek", badge: "Performance Paddles", imgAlt: "Paddletek brand image" },
    { name: "Padeltek", badge: "Performance Rackets", imgAlt: "Padeltek brand image" },
    { name: "ProXR Pickleball", badge: "Innovative Paddles", imgAlt: "ProXR Pickleball brand image" },
    { name: "Example Brand 4", badge: "Accessories", imgAlt: "Example brand 4 image" },
    { name: "Example Brand 5", badge: "Apparel", imgAlt: "Example brand 5 image" },
    { name: "Example Brand 6", badge: "Bags", imgAlt: "Example brand 6 image" },
    { name: "Example Brand 7", badge: "Balls", imgAlt: "Example brand 7 image" },
  ],
  Baseball: [
    { name: "Example Baseball 1", badge: "Gloves", imgAlt: "Example baseball 1 image" },
    { name: "Example Baseball 2", badge: "Bats", imgAlt: "Example baseball 2 image" },
    { name: "Example Baseball 3", badge: "Training", imgAlt: "Example baseball 3 image" },
  ],
  "Sport Style": [
    { name: "Example Style 1", badge: "Footwear", imgAlt: "Example style 1 image" },
    { name: "Example Style 2", badge: "Athleisure", imgAlt: "Example style 2 image" },
    { name: "Example Style 3", badge: "Outerwear", imgAlt: "Example style 3 image" },
  ],
  Training: [
    { name: "Example Training 1", badge: "Agility", imgAlt: "Example training 1 image" },
    { name: "Example Training 2", badge: "Recovery", imgAlt: "Example training 2 image" },
    { name: "Example Training 3", badge: "Strength", imgAlt: "Example training 3 image" },
  ],
};

const HOURS = [
  ["Monday", "10 am–5 pm"],
  ["Tuesday", "10 am–5 pm"],
  ["Wednesday", "10 am–5 pm"],
  ["Thursday", "10 am–5 pm"],
  ["Friday", "10 am–5 pm"],
  ["Saturday", "Closed"],
  ["Sunday", "Closed"],
];

const ADDRESS_LINE = "220 Messner Dr, Wheeling, IL 60090";
const PHONE = "(847)780-4094";
const EMAIL = "windycitysports@35services.com";
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="https://use.typekit.net/vra0lhe.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Windy City Sports Outlet</title>

    <style is:global>
      :root{
        --navy: #1F4968;
        --red: #EA1313;
        --light-blue: #B5E3F3;
        --bg: #ffffff;
        --max: 1120px;

        /* Marquee speed: larger = slower */
        --marquee-duration: 30s;

        /* Brands */
        --brands-gap: 40px;
        --brands-gap-mobile: 16px;
        --overlay-bg: rgba(31, 73, 104, .78);
      }

      *{ box-sizing: border-box; }
      html{ scroll-behavior: smooth; }
      body{
        margin: 0;
        color: #000;
        background: var(--bg);
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      }
      a{ color: inherit; text-decoration: none; }

      /* Top slim navy bar */
      .topbar{
        background: var(--navy);
        color: var(--light-blue);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-size: 12px;
        line-height: 1;
        padding: 10px 12px;
        text-align: center;
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
      }

      /* Red marquee banner (seamless) */
      .marquee{
        background: var(--red);
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        overflow: hidden;
        white-space: nowrap;
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
        font-size: 12px;
      }
      .marquee__viewport{ position: relative; }
      .marquee__viewport::before,
      .marquee__viewport::after{
        content:"";
        position:absolute;
        top:0; bottom:0;
        width: 36px;
        pointer-events:none;
        z-index: 2;
      }
      .marquee__viewport::before{
        left:0;
        background: linear-gradient(90deg, rgba(234,19,19,1) 0%, rgba(234,19,19,0) 100%);
      }
      .marquee__viewport::after{
        right:0;
        background: linear-gradient(270deg, rgba(234,19,19,1) 0%, rgba(234,19,19,0) 100%);
      }
      .marquee__track{
        display: inline-flex;
        align-items: center;
        will-change: transform;
        animation: marquee var(--marquee-duration) linear infinite;
      }
      .marquee__group{
        display: inline-flex;
        align-items: center;
      }
      .marquee__item{
        display: inline-flex;
        align-items: center;
        padding: 10px 12px;
      }
      .marquee__starImg{
        width: 14px;
        height: 14px;
        object-fit: contain;
        display: inline-block;
        margin-left: 12px;
      }
      @keyframes marquee{
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
      }

      /* Header */
      header{ background: #fff; }
      .header__inner{
        max-width: var(--max);
        margin: 0 auto;
        padding: 18px 18px 12px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
      }
      .logoLink{ display: inline-flex; align-items: center; }
      .logoImg{ width: 160px; height: auto; display: block; }

      nav{
        display: flex;
        align-items: center;
        gap: 26px;
        padding-top: 10px;
        color: #000;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
      }
      nav a{ font-size: 18px; }
      nav a:hover{
        text-decoration: underline;
        text-underline-offset: 6px;
      }

      /* Hero */
      .heroFullBleed{ width: 100%; }
      .heroImg{
        width: 100%;
        height: 600px;
        display: block;
        object-fit: cover;
      }

      /* Intro section */
      .oneStop{
        padding: 80px 18px 22px;
        text-align: center;
      }
      .starsWrap{
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
      }
      .starsImg{ width: 96px; height: auto; display: block; }

      .h1{
        margin: 0;
        font-size: 44px;
        line-height: 1.02;
        letter-spacing: 0.02em;
        color: var(--navy);
        text-transform: uppercase;
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
      }
      .subhead{
        margin: 10px auto 18px;
        font-size: 28px;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
      }
      .body{
        max-width: 840px;
        margin: 0 auto;
        color: #000;
        font-size: 18px;
        line-height: 1.55;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
        text-align: left;
        padding: 40px;
      }
      .body p{ margin: 0 0 14px; }

      /* Hours band */
      .hoursBand{
        background: var(--navy);
        color: #fff;
        padding: 80px 18px;
      }
      .hoursBand__inner{
        max-width: var(--max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: center;
      }
      .hoursImg{
        width: 80%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        display: block;
        background: var(--navy);
      }
      .hoursTitle{
        margin: 0 0 16px;
        font-size: 28px;
        color: var(--light-blue);
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
      }
      .hoursList{
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 10px;
        max-width: 360px;
      }
      .hoursRow{
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1px;
        font-size: 18px;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
      }

      /* =========================
         Brands We Carry (one-by-one carousel)
         - Desktop shows 3 cards at once, but advances 1 card per click/swipe.
         - Mobile is swipeable with snap; arrows also move 1 card.
         ========================= */

      .brands{ padding: 80px 18px 10px; }
      .brands__inner{ max-width: var(--max); margin: 0 auto; }

      .brandsTop{
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 18px;
      }
      .brandsTitle{
        margin: 0;
        color: var(--red);
        font-size: 28px;
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
      }

      .tabs{
        display: flex;
        align-items: center;
        gap: 42px;
        font-size: 18px;
        color: #000;
        font-family: "futura-pt", sans-serif;
        font-weight: 600;
        max-width: 100%;
      }
      .tab{
        padding: 0 0 8px;
        border: 0;
        background: transparent;
        cursor: pointer;
        font: inherit;
        color: inherit;
        border-bottom: 3px solid transparent;
        white-space: nowrap;
      }
      .tab[aria-selected="true"]{ border-bottom-color: #000; }

      /* Rail holds arrows outside the container like "<  ...  >" */
      .cardsRail{
        position: relative;
        max-width: var(--max);
        margin: 0 auto;
      }

      /* Viewport clips overflow so only 3 show on desktop */
      .cardsViewport{
        width: 100%;
        overflow: hidden; /* important: keeps “hidden cards” offscreen */
      }

      /* Scroller is what we actually scroll (JS + touch/trackpad) */
      .cardsScroller{
        display: flex;
        gap: var(--brands-gap);
        width: 100%;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scroll-behavior: smooth;
        padding-bottom: 6px; /* a tiny buffer so scrollbars (if shown) don't overlap */
      }
      /* Hide scrollbar chrome (keeps it clean on desktop) */
      .cardsScroller{
        scrollbar-width: none;      /* Firefox */
      }
      .cardsScroller::-webkit-scrollbar{
        width: 0;
        height: 0;
      }

      /* Card: fixed 4x5 panel. Width is exactly 1/3 of the viewport (minus 2 gaps). */
      .card{
        position: relative;
        flex: 0 0 calc((100% - (2 * var(--brands-gap))) / 3);
        aspect-ratio: 4 / 5;
        overflow: hidden;
        background: #eee;
        scroll-snap-align: start;
      }
      .card__img{
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      /* Bottom overlay */
      .card__overlay{
        position: absolute;
        left: 0; right: 0; bottom: 0;
        background: var(--overlay-bg);
        padding: 24px 22px 20px;
        z-index: 2;
      }
      .card__name{
        margin: 0 0 10px;
        color: #fff;
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
        font-size: 28px;
        line-height: 1.05;
      }
      .card__badge{
        display: inline-block;
        background: var(--red);
        color: #fff;
        font-family: "futura-pt", sans-serif;
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.04em;
        padding: 7px 14px;
        line-height: 1;
      }

      /* Pager arrows positioned OUTSIDE the container edges */
      .pager{
        position: absolute;
        top: 50%;
        left: -42px;
        right: -42px;
        transform: translateY(-50%);
        display: flex;
        justify-content: space-between;
        pointer-events: none; /* only buttons receive clicks */
        z-index: 5;
      }
      .pager button{
        pointer-events: auto;
        width: 34px;
        height: 34px;
        border: 0;
        background: transparent;
        cursor: pointer;
        font-size: 34px;
        line-height: 1;
        color: #000;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
      }
      .pager button:disabled{
        opacity: 0.25;
        cursor: not-allowed;
      }

      /* Visit section */
      .visit{ padding: 80px 18px 0; }
      .visit__inner{ max-width: var(--max); margin: 0 auto; }
      .visitTitle{
        margin: 0 0 8px;
        color: var(--red);
        font-size: 28px;
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
      }
      .visitAddr{
        margin: 0 0 14px;
        font-size: 18px;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
      }
      .map{
        width: 100%;
        height: 500px;
        overflow: hidden;
        background: #fff;
      }
      .map iframe{ width: 100%; height: 100%; border: 0; }

      /* Contact */
      .contact{
        padding: 80px 18px;
        text-align: center;
      }
      .contactTitle{
        margin: 0 0 8px;
        color: var(--red);
        font-size: 28px;
        font-family: "futura-pt", sans-serif;
        font-weight: 700;
      }
      .contact p{
        margin: 6px 0;
        font-size: 18px;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
      }
      .fbIcon{
        width: 26px;
        height: 26px;
        display: inline-block;
        margin-top: 6px;
        object-fit: contain;
      }

      /* Footer */
      footer{
        background: var(--navy);
        color: #fff;
        padding: 44px 18px 28px;
        text-align: center;
        font-family: "futura-pt", sans-serif;
        font-weight: 400;
      }
      .footerLogoImg{
        width: 170px;
        height: auto;
        display: block;
        margin: 0 auto 12px;
      }
      .fine{
        font-size: 11px;
        opacity: .9;
        line-height: 1.6;
      }

      /* Responsive */
      @media (max-width: 920px){
        .heroImg{ height: 300px; }
        .hoursBand__inner{ grid-template-columns: 1fr; }

        /* Header stack */
        .header__inner{
          flex-direction: column;
          align-items: center;
          padding-top: 14px;
          padding-bottom: 14px;
        }
        .logoImg{ width: 220px; }
        nav{
          flex-wrap: wrap;
          justify-content: center;
          row-gap: 10px;
          column-gap: 18px;
          padding-top: 8px;
          max-width: 100%;
        }

        /* Brands header stack + wrap tabs */
        .brandsTop{
          flex-direction: column;
          align-items: flex-start;
          gap: 12px;
        }
        .tabs{
          flex-wrap: wrap;
          row-gap: 10px;
          column-gap: 18px;
          justify-content: flex-start;
          font-size: 15px;
        }
        .tab{ padding-bottom: 6px; }

        /* Mobile carousel sizing */
        .cardsScroller{
          gap: var(--brands-gap-mobile);
        }
        .card{
          flex: 0 0 78%;
        }

        /* Keep arrows slightly inset so they don't clip */
        .pager{
          left: -10px;
          right: -10px;
        }
      }

      @media (prefers-reduced-motion: reduce){
        html{ scroll-behavior: auto; }
        .marquee__track{ animation: none; }
        .cardsScroller{ scroll-behavior: auto; }
      }
    </style>
  </head>

  <body>
    <div class="topbar">
      OUR PROS ARE HERE TO HELP YOU FIND THE RIGHT PICKLEBALL, PADEL, AND BASEBALL EQUIPMENT
    </div>

    <!-- Marquee: duplicated groups = seamless -->
    <div class="marquee" aria-label="Grand opening banner">
      <div class="marquee__viewport">
        <div class="marquee__track" aria-hidden="true">
          <div class="marquee__group">
            {Array.from({ length: 10 }).map(() => (
              <span class="marquee__item">
                Grand Opening 2/16
                <img class="marquee__starImg" src="/white-star.svg" alt="white six-point star" />
              </span>
            ))}
          </div>
          <div class="marquee__group" aria-hidden="true">
            {Array.from({ length: 10 }).map(() => (
              <span class="marquee__item">
                Grand Opening 2/16
                <img class="marquee__starImg" src="/white-star.svg" alt="white six-point star" />
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <header>
      <div class="header__inner">
        <a class="logoLink" href="#top" aria-label="Windy City Sports Outlet home">
          <img class="logoImg" src="/wcso_primary-logo_color-black.png" alt="Windy City Sports Outlet logo" />
        </a>

        <nav aria-label="Primary navigation">
          <a href="#hours">Hours</a>
          <a href="#brands">Brands</a>
          <a href="#visit">Visit</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>

      <div class="heroFullBleed" id="top">
        <img class="heroImg" src="/wcso_hero-banner.jpg" alt="interior of Windy City Sports Outlet store" />
      </div>
    </header>

    <main>
      <section class="oneStop" aria-label="Intro">
        <div class="starsWrap">
          <img class="starsImg" src="/red-star_cluster.svg" alt="three red six-point stars" />
        </div>

        <h1 class="h1">YOUR ONE-STOP SHOP</h1>
        <div class="subhead">Find the High-Quality Equipment That Is Right for You</div>

        <div class="body">
          <p>
            We specialize in pickleball, padel, and baseball gear, along with a wide selection of equipment and apparel
            for athletes of all ages. Whether you’re a beginner or a seasoned player, our friendly team will help you find
            the right gear to elevate your game.
          </p>
          <p>
            Our sporting goods showroom features paddles, rackets, gloves, bats, footwear, bags, and accessories. We
            also offer an indoor test court and a custom shop where you can build personalized or branded pickle ball
            equipment for charity or corporate functions.
          </p>
          <p>
            We’ve got everything you need under one roof. Stop by today and gear up with the best at Windy City
            Sports Outlet!
          </p>
        </div>
      </section>

      <section id="hours" class="hoursBand" aria-label="Our Hours">
        <div class="hoursBand__inner">
          <img class="hoursImg" src="/wcso_cropped-image.jpg" alt="Chicago Slice merchandise in Windy City Sports Outlet store" />

          <div>
            <h2 class="hoursTitle">Our Hours</h2>
            <ul class="hoursList">
              {HOURS.map(([day, hours]) => (
                <li class="hoursRow">
                  <span>{day}</span>
                  <span>{hours}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="brands" class="brands" aria-label="Brands We Carry">
        <div class="brands__inner">
          <div class="brandsTop">
            <h2 class="brandsTitle">Brands We Carry</h2>

            <div class="tabs" role="tablist" aria-label="Brand categories">
              {Object.keys(BRANDS).map((key, idx) => (
                <button
                  class="tab"
                  type="button"
                  role="tab"
                  aria-selected={idx === 0 ? "true" : "false"}
                  data-tab={key}
                >
                  {key}
                </button>
              ))}
            </div>
          </div>

          <div class="cardsRail">
            <!-- Viewport clips the hidden cards on desktop -->
            <div class="cardsViewport">
              <!-- Scroller is what you swipe/scroll; JS also scrolls it 1 card at a time -->
              <div class="cardsScroller" id="brand-scroller" aria-live="polite"></div>
            </div>

            <div class="pager" aria-label="Brand carousel controls">
              <button id="brands-prev" type="button" aria-label="Previous brand">‹</button>
              <button id="brands-next" type="button" aria-label="Next brand">›</button>
            </div>
          </div>
        </div>
      </section>

      <section id="visit" class="visit" aria-label="Visit">
        <div class="visit__inner">
          <h2 class="visitTitle">Visit</h2>
          <p class="visitAddr">{ADDRESS_LINE}</p>

          <div class="map" role="application" aria-label="Interactive map">
            <iframe
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              src={`https://www.google.com/maps?q=${encodeURIComponent(ADDRESS_LINE)}&output=embed`}
              title="Windy City Sports Outlet Map"
            ></iframe>
          </div>
        </div>
      </section>

      <section id="contact" class="contact" aria-label="Contact">
        <h2 class="contactTitle">Contact</h2>
        <p>{PHONE}</p>
        <p>{EMAIL}</p>

        <a href="#" aria-label="Facebook link">
          <img class="fbIcon" src="/facebook_primary-logo.svg" alt="Facebook primary logo" />
        </a>
      </section>
    </main>

    <footer>
      <img class="footerLogoImg" src="/wcso_secondary-logo_color-white.png" alt="Windy City Sports Outlet logo" />
      <div class="fine">
        © 2026 Windy City Sports Outlet<br/>
        {ADDRESS_LINE} &nbsp;|&nbsp; {PHONE} &nbsp;|&nbsp; {EMAIL}
      </div>
    </footer>

    <script>
      // Card data (edit src paths in /public)
      const brandData = {
        "Pickleball/Padel": [
          { name: "Paddletek", badge: "Performance Paddles", img: "/paddletek_card.jpg" },
          { name: "Padeltek", badge: "Performance Rackets", img: "/padeltek_card.jpg" },
          { name: "ProXR Pickleball", badge: "Innovative Paddles", img: "/proxr-pickleball_card.jpg" },
          { name: "Example Brand 4", badge: "Accessories", img: "" },
          { name: "Example Brand 5", badge: "Apparel", img: "" },
          { name: "Example Brand 6", badge: "Bags", img: "" },
          { name: "Example Brand 7", badge: "Balls", img: "" },
        ],
        Baseball: [
          { name: "Example Baseball 1", badge: "Gloves", img: "" },
          { name: "Example Baseball 2", badge: "Bats", img: "" },
          { name: "Example Baseball 3", badge: "Training", img: "" },
        ],
        "Sport Style": [
          { name: "Example Style 1", badge: "Footwear", img: "" },
          { name: "Example Style 2", badge: "Athleisure", img: "" },
          { name: "Example Style 3", badge: "Outerwear", img: "" },
        ],
        Training: [
          { name: "Example Training 1", badge: "Agility", img: "" },
          { name: "Example Training 2", badge: "Recovery", img: "" },
          { name: "Example Training 3", badge: "Strength", img: "" },
        ],
      };

      const scroller = document.getElementById("brand-scroller");
      const tabs = Array.from(document.querySelectorAll(".tab"));
      const prevBtn = document.getElementById("brands-prev");
      const nextBtn = document.getElementById("brands-next");

      let activeCategory = tabs[0]?.dataset.tab || "Pickleball/Padel";

      function setTabSelected(category){
        tabs.forEach(t => t.setAttribute("aria-selected", String(t.dataset.tab === category)));
      }

      function getGapPx(){
        const gap = getComputedStyle(scroller).gap || "0px";
        const n = parseFloat(gap);
        return Number.isFinite(n) ? n : 0;
      }

      function getStepPx(){
        // Scroll exactly one card at a time (card width + gap)
        const firstCard = scroller.querySelector(".card");
        const cardW = firstCard ? firstCard.getBoundingClientRect().width : 0;
        return cardW + getGapPx();
      }

      function updatePager(){
        const maxScroll = scroller.scrollWidth - scroller.clientWidth;
        const x = scroller.scrollLeft;

        // Small tolerance keeps “almost at edge” from flickering
        prevBtn.disabled = x <= 2;
        nextBtn.disabled = x >= (maxScroll - 2);

        // If everything fits (no overflow), hide the arrows
        const shouldShow = maxScroll > 2;
        prevBtn.style.visibility = shouldShow ? "visible" : "hidden";
        nextBtn.style.visibility = shouldShow ? "visible" : "hidden";
      }

      function renderCards(){
        const items = brandData[activeCategory] || [];
        scroller.innerHTML = "";

        items.forEach(item => {
          const card = document.createElement("article");
          card.className = "card";

          // Image (leave blank until you set it)
          const img = document.createElement("img");
          img.className = "card__img";
          img.alt = item.name + " brand image";
          img.src = item.img || "";

          // Overlay
          const overlay = document.createElement("div");
          overlay.className = "card__overlay";

          const name = document.createElement("p");
          name.className = "card__name";
          name.textContent = item.name;

          const badge = document.createElement("span");
          badge.className = "card__badge";
          badge.textContent = item.badge;

          overlay.appendChild(name);
          overlay.appendChild(badge);

          card.appendChild(img);
          card.appendChild(overlay);
          scroller.appendChild(card);
        });

        // Reset position when switching categories
        scroller.scrollLeft = 0;
        updatePager();
      }

      // Tabs: swap category + re-render
      tabs.forEach(btn => {
        btn.addEventListener("click", () => {
          activeCategory = btn.dataset.tab;
          setTabSelected(activeCategory);
          renderCards();
        });
      });

      // Arrows: always move ONE card at a time
      prevBtn.addEventListener("click", () => {
        scroller.scrollBy({ left: -getStepPx(), behavior: "smooth" });
      });
      nextBtn.addEventListener("click", () => {
        scroller.scrollBy({ left: getStepPx(), behavior: "smooth" });
      });

      // Keep arrow enabled/disabled correct during swipe/trackpad scroll
      scroller.addEventListener("scroll", () => {
        window.requestAnimationFrame(updatePager);
      });

      // If the layout changes (desktop <-> mobile), recompute widths + pager state
      window.addEventListener("resize", () => {
        updatePager();
      });

      // Init
      setTabSelected(activeCategory);
      renderCards();
    </script>
  </body>
</html>
